---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page does not exist.">
  <section class="mx-auto max-w-[88rem]">
    <p class="data text-signal">Error 404</p>
    <h1 class="font-display mt-6 text-4xl sm:text-6xl">Nothing at this address</h1>
    <p class="measure text-graphite mt-6 text-lg">
      The page you asked for is not on this site.
    </p>
    <hr class="rule mt-10" />
    <p class="mt-6">
      <a href="/" class="data hover:text-signal underline transition-colors">Return home</a>
    </p>
  </section>
</BaseLayout>
