---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import SplitFlapBoard from "../components/SplitFlapBoard.astro";
import TypeBoard from "../components/TypeBoard.astro";
import AltimeterTape from "../components/AltimeterTape.astro";
import { buildFilters, loadPhotos } from "../lib/photos";

const photos = await loadPhotos();
// The type board below is the type filter, drawn out, so the bar does not
// carry a second copy of the same list.
const filters = buildFilters(photos).filter((g) => g.id !== "aircraft");
---

<BaseLayout
  title="Spotting"
  description="Aircraft photography by Griffin Thomas, shot at Sea-Tac, Boeing Field, and Sky Harbor on a Canon Rebel T7."
>
  <div class="mx-auto max-w-[88rem]">
    <header>
      <p class="data">Canon EOS Rebel T7 / EF 75-300mm</p>
      <h1 class="font-display mt-5 text-5xl sm:text-7xl">Spotting</h1>
    </header>

    {
      photos.length > 0 && (
        <section class="mt-16" aria-labelledby="board-heading">
          <div class="border-rule border-b pb-2">
            <h2 id="board-heading" class="font-display text-3xl">
              Latest
            </h2>
          </div>

          <div class="mt-8">
            <SplitFlapBoard photos={photos} limit={5} />
          </div>
        </section>
      )
    }

    {photos.length > 0 && <TypeBoard photos={photos} mode="caught" />}

    {
      photos.length > 0 ? (
        <>
          <PhotoGallery photos={photos} filters={filters} />
          <TypeBoard photos={photos} mode="wanted" />
        </>
      ) : (
        <p class="data mt-16">
          <span class="text-signal">Empty</span>
          <span class="text-rule mx-2">/</span>
          <span>Run npm run photos to import the library</span>
        </p>
      )
    }
  </div>

  {/* Only here. It is a scroll indicator dressed as an instrument, which suits
      the page full of aeroplanes and would be a costume anywhere else. */}
  <AltimeterTape />
</BaseLayout>
