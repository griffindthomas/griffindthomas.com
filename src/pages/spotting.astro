---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { buildFilters, galleryStats, loadPhotos } from "../lib/photos";

const photos = await loadPhotos();
const filters = buildFilters(photos);
const stats = galleryStats(photos);

// Every figure here is counted from the library at build time. None of it is
// typed by hand, so it cannot drift out of date as photos are added.
const readout = [
  { label: "Photos", value: String(stats.count) },
  { label: "Airfields", value: String(stats.fields) },
  { label: "Types", value: String(stats.types) },
  { label: "Operators", value: String(stats.operators) },
  { label: "Longest lens", value: stats.longestLens ? `${stats.longestLens}mm` : "n/a" },
  { label: "Latest", value: stats.latest },
];
---

<BaseLayout
  title="Spotting"
  description="Aircraft photography by Griffin Thomas, shot at Sea-Tac, Boeing Field, and Sky Harbor on a Canon Rebel T7."
>
  <div class="mx-auto max-w-[88rem]">
    <header>
      <p class="data">Canon EOS Rebel T7 / EF 75-300mm</p>
      <h1 class="font-display mt-5 text-5xl sm:text-7xl">Spotting</h1>
      <p class="measure text-graphite mt-6 text-lg leading-relaxed">
        Airliners and whatever the Navy brings to Seafair. Shot from the fences at Sea-Tac
        and Boeing Field, and from Sky Harbor once I am back in Tempe. Everything here is
        my own frame, with the type and registration read off the airframe rather than
        guessed at afterwards.
      </p>
    </header>

    <dl class="border-rule mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t pt-6 sm:grid-cols-3 lg:grid-cols-6">
      {
        readout.map((r) => (
          <div>
            <dt class="data text-rule">{r.label}</dt>
            <dd class="font-display mt-1 text-2xl tabular-nums">{r.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      photos.length > 0 ? (
        <PhotoGallery photos={photos} filters={filters} />
      ) : (
        <p class="data mt-16">
          <span class="text-signal">Empty</span>
          <span class="text-rule mx-2">/</span>
          <span>Run npm run photos to import the library</span>
        </p>
      )
    }
  </div>
</BaseLayout>
