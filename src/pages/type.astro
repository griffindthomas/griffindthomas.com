---
// THROWAWAY. Delete this route (and its font dependencies, if unused) once
// Griffin picks a display face. Excluded from the sitemap in astro.config.mjs
// and marked noindex.
//
// Only the DISPLAY face changes between specimens. Body stays Inter and all
// data stays JetBrains Mono, so the comparison isolates one variable.
import BaseLayout from "../layouts/BaseLayout.astro";

import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/fraunces";

const candidates = [
  {
    name: "Instrument Serif",
    stack: '"Instrument Serif", Georgia, serif',
    note: "Current. High contrast, narrow, modern-editorial. Reads sharp at huge sizes; least traditional of the four.",
  },
  {
    name: "EB Garamond",
    stack: '"EB Garamond Variable", Garamond, Georgia, serif',
    note: "A true old-style face, 16th-century lineage. The most literally old-money. Quietest of the four - can read timid at hero scale.",
  },
  {
    name: "Newsreader",
    stack: '"Newsreader Variable", Georgia, serif',
    note: "Contemporary editorial serif built for screens. Warmer than Instrument, more assertive than Garamond.",
  },
  {
    name: "Fraunces",
    stack: '"Fraunces Variable", Georgia, serif',
    note: "Soft-serif with real personality and a wonky, hand-cut quality. Most distinctive; also the most likely to date.",
  },
];

const bio =
  "Aerospace engineering student at Arizona State. Planespotter, RC aircraft builder, and lifeguard. Climbing the Cascade volcanoes one at a time.";
---

<BaseLayout
  title="Type specimens"
  description="Throwaway display-face comparison."
  noindex={true}
>
  <section class="mx-auto max-w-[88rem]">
    <p class="data text-signal">Throwaway page — delete after choosing</p>
    <h1 class="font-display mt-4 text-4xl sm:text-5xl">Display face</h1>
    <p class="measure text-graphite mt-4">
      Same content four times. Only the display face changes — body text stays Inter and all
      data stays JetBrains Mono. Judge the headline first at full width, then check how the
      section heading holds up at small size.
    </p>

    <div class="mt-16 space-y-24">
      {
        candidates.map((face, i) => (
          <article>
            <div class="border-rule flex items-baseline justify-between border-b pb-2">
              <p class="data text-ink">
                <span class="text-signal">{String(i + 1).padStart(2, "0")}</span>
                <span class="mx-2">/</span>
                <span>{face.name}</span>
              </p>
              <p class="data hidden sm:block">Display only</p>
            </div>

            <p class="measure text-graphite mt-4 text-sm">{face.note}</p>

            {/* Hero scale - the decisive test */}
            <p
              class="mt-8 text-5xl leading-[0.95] sm:text-7xl lg:text-[7rem]"
              style={`font-family: ${face.stack}`}
            >
              Griffin Thomas
            </p>

            {/* Section-heading scale */}
            <p class="mt-10 text-3xl sm:text-4xl" style={`font-family: ${face.stack}`}>
              Spotting — Boeing Field, July
            </p>

            {/* Body + data, held constant */}
            <p class="measure text-graphite mt-6 text-lg leading-relaxed">{bio}</p>

            <p class="data mt-6">
              <span>KBFI</span>
              <span class="text-rule mx-2">/</span>
              <span>N604SK</span>
              <span class="text-rule mx-2">/</span>
              <span>CRJ7</span>
              <span class="text-rule mx-2">/</span>
              <span>1/400s f/11 ISO 100</span>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
