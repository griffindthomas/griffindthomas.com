---
import BaseLayout from "../layouts/BaseLayout.astro";
import SwimProgression from "../components/SwimProgression.astro";
---

<BaseLayout
  title="About"
  description="Griffin Thomas — aerospace engineering student at Arizona State University, planespotter, and breaststroke swimmer."
>
  <div class="mx-auto max-w-[88rem]">
    <section>
      <p class="data">Tempe, Arizona / West Seattle, Washington</p>
      <h1 class="font-display mt-5 text-4xl sm:text-6xl">About</h1>

      <div class="measure text-graphite mt-8 space-y-5 text-lg leading-relaxed">
        <p>
          I&rsquo;m an aerospace engineering student at Arizona State, in the Aeronautics
          concentration at the Ira A. Fulton Schools of Engineering.
        </p>
        <p>
          I grew up in West Seattle, spent high school in New Hampshire, and I&rsquo;m back in
          the Pacific Northwest every summer. I design and build RC aircraft, run an ADS-B
          ground station, photograph aircraft at SEA, BFI, and PHX, and I lifeguard. I&rsquo;m
          climbing the Cascade volcanoes one at a time.
        </p>
      </div>
    </section>

    <SwimProgression />
  </div>
</BaseLayout>
