---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import { PROFILES, SITE, coordinates } from "../config/site";
import { galleryStats, loadPhotos } from "../lib/photos";
import SplitFlapText from "../components/SplitFlapText.astro";

const photos = await loadPhotos();
const stats = galleryStats(photos);

// Fall back to the newest frames if nothing has been flagged, so the home page
// is never empty just because a checkbox was missed in the studio.
const featured = photos.filter((p) => p.data.featured);
const showcase = (featured.length >= 3 ? featured : photos).slice(0, 3);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

/**
 * Structured data, so a search engine knows this is a person rather than
 * guessing from the words on the page.
 *
 * The job it actually does is disambiguation: `sameAs` is how Google ties this
 * site to the LinkedIn, GitHub and SwimCloud accounts and works out they are
 * one person. Someone who half remembers a name after a career fair is the
 * reader this is for.
 *
 * Every value is read from the site config, so it cannot drift away from what
 * the pages say. Nothing here is a claim that is not already on the site.
 */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  image: new URL("/og.png", SITE.url).href,
  description: SITE.tagline,
  jobTitle: "Aerospace engineering student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Arizona State University",
    url: "https://www.asu.edu/",
  },
  knowsAbout: [
    "Aerospace engineering",
    "Aircraft design",
    "Aircraft photography",
    "ADS-B",
    "3D printing",
  ],
  sameAs: PROFILES.map((profile) => profile.href),
};
---

<BaseLayout title={SITE.name} description={SITE.tagline}>
  <div class="mx-auto max-w-[88rem]">
    <section>
      {/* The coordinates are Seattle, the label is Tempe. See src/config/site.ts.
          Both this and the pair in the footer are the way into /trips, which is
          not in the nav on purpose. */}
      <p class="data">
        {SITE.base.label}
        <span class="text-rule mx-2">/</span>
        <a href="/trips" aria-label="Trips" class="hover:text-signal transition-colors">
          {coordinates(SITE.home.lat, SITE.home.lon)}
        </a>
      </p>

      <h1 class="font-display mt-6 text-5xl leading-[0.95] sm:text-7xl lg:text-[7rem]">
        Griffin Thomas
      </h1>

      <p class="measure text-graphite mt-8 text-lg leading-relaxed">
        Aerospace engineering student at Arizona State. I build RC aircraft and photograph
        airliners at SEA, Boeing Field, and Sky Harbor.
      </p>
    </section>

    {
      showcase.length > 0 && (
        <section class="mt-20" aria-labelledby="recent-heading">
          <div class="border-rule flex items-baseline justify-between gap-6 border-b pb-2">
            <h2 id="recent-heading" class="font-display text-3xl">
              Recent shots
            </h2>
            <a href="/spotting" class="data hover:text-signal transition-colors">
              All {stats.count}
              <span class="ml-2" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </div>

          <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-3">
            {showcase.map((p, i) => (
              <li>
                <a href={`/spotting?photo=${p.slug}`} class="group block">
                  <div class="bg-paper-sunk aspect-[3/2] overflow-hidden">
                    <Image
                      src={p.data.image}
                      alt={`${p.data.operator} ${p.data.aircraft}`}
                      widths={[400, 800]}
                      sizes="(max-width: 640px) 100vw, 33vw"
                      loading={i === 0 ? "eager" : "lazy"}
                      class="h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-90"
                      style={`background-image:url(${p.data.lqip});background-size:cover;background-position:center`}
                    />
                  </div>

                  <p class="border-rule mt-3 border-t pt-3">
                    <SplitFlapText text={p.data.aircraft} class="sf-card" group={i} />
                  </p>
                  <p class="data mt-1">
                    <span>{p.data.operator}</span>
                    <span class="text-rule mx-2">/</span>
                    <span>{p.place}</span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-20" aria-labelledby="build-heading">
      <div class="border-rule flex items-baseline justify-between gap-6 border-b pb-2">
        <h2 id="build-heading" class="font-display text-3xl">What I am building</h2>
        <a href="/projects" class="data hover:text-signal transition-colors">
          All projects
          <span class="ml-2" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ol class="mt-4">
        {
          projects.map((project, i) => (
            <li class="border-rule border-b">
              <a
                href={`/projects/${project.id}`}
                class="group grid items-baseline gap-x-8 gap-y-2 py-6 lg:grid-cols-12"
              >
                <span class="data text-signal lg:col-span-1">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="font-display group-hover:text-signal text-2xl transition-colors lg:col-span-4">
                  {project.data.title}
                </h3>
                <p class="text-graphite lg:col-span-6">{project.data.summary}</p>
                <span class="data lg:col-span-1 lg:text-right">{project.data.period}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {/* Valid anywhere in the document, and this page owns the claim, so it
        lives here rather than in the shared layout. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />

    <section class="mt-20">
      <p class="font-display max-w-[24ch] text-3xl sm:text-4xl">
        Looking for a summer 2027 aerospace internship in design, test, or manufacturing.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/resume"
          class="border-ink hover:bg-ink hover:text-paper data border px-5 py-3 transition-colors"
        >
          Read the resume
        </a>
        <a
          href="/contact"
          class="border-rule hover:border-ink hover:text-ink data border px-5 py-3 transition-colors"
        >
          Get in touch
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
