---
import { loadLog } from "../lib/log";

/**
 * The Log link appears only once something has been written. An empty section
 * in the nav is a promise the site is not keeping, and this way publishing the
 * first entry is a one-file change with no nav edit to remember.
 */
const hasLog = (await loadLog()).length > 0;

const links = [
  { href: "/resume", label: "Resume" },
  { href: "/spotting", label: "Spotting" },
  { href: "/projects", label: "Projects" },
  ...(hasLog ? [{ href: "/log", label: "Log" }] : []),
  { href: "/contact", label: "Contact" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
/** Treat nested routes (/projects/foo) as their section being active. */
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-rule bg-paper/90 sticky top-0 z-40 border-b backdrop-blur-sm">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-[88rem] flex-col gap-2 px-5 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:px-8 sm:py-4 lg:px-12"
  >
    {/* Crest plus wordmark.
        The wordmark is set in Newsreader rather than taken from the supplied
        logo art, whose lettering is a geometric sans. Three typefaces would
        fight, and that one pulls towards a sports badge rather than the rest
        of this site. The griffin carries the identity; the type stays the
        site's own. */}
    <a
      href="/"
      class="group flex items-center gap-3 transition-colors"
      aria-label="Griffin Thomas, home"
    >
      <span class="crest" aria-hidden="true"></span>
      <span
        class="font-display group-hover:text-signal text-xl leading-none tracking-tight transition-colors"
      >
        Griffin Thomas
      </span>
    </a>

    {/* Wraps onto its own line below the wordmark on narrow screens, which
        avoids a hamburger menu for what is only ever six short labels. */}
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 sm:gap-x-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "data hover:text-ink transition-colors",
                isActive(link.href) ? "text-signal" : "text-graphite",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* The crest is painted with `mask-image`, not shipped as a coloured PNG.
     The artwork carries its whole shape in the alpha channel, so masking a
     background colour through it means the mark follows the palette tokens
     and can change on hover, from one file with no second asset to keep in
     sync. Same trick a coloured icon font would use, without the font. */
  /* Hidden by default and only revealed where masking actually works. Without
     the guard, a browser that ignores `mask` paints the fallback background
     across the whole box and the crest becomes a navy rectangle next to the
     name. Dropping the mark is a far better failure than that; the wordmark
     still carries the identity. */
  .crest {
    display: none;
    width: 2.75rem;
    height: 1.55rem;
    flex-shrink: 0;
  }

  @supports ((-webkit-mask-image: url("/crest.png")) or (mask-image: url("/crest.png"))) {
    .crest {
      display: block;
      background-color: var(--color-chart);
      -webkit-mask: url("/crest.png") center / contain no-repeat;
      mask: url("/crest.png") center / contain no-repeat;
      transition: background-color 160ms ease;
    }

    .group:hover .crest {
      background-color: var(--color-signal);
    }
  }
</style>
