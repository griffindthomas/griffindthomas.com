---
import { loadLog } from "../lib/log";

/**
 * The Log link appears only once something has been written. An empty section
 * in the nav is a promise the site is not keeping, and this way publishing the
 * first entry is a one-file change with no nav edit to remember.
 */
const hasLog = (await loadLog()).length > 0;

const links = [
  { href: "/spotting", label: "Spotting" },
  { href: "/projects", label: "Projects" },
  ...(hasLog ? [{ href: "/log", label: "Log" }] : []),
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
/** Treat nested routes (/projects/foo) as their section being active. */
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-rule bg-paper/90 sticky top-0 z-40 border-b backdrop-blur-sm">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-[88rem] flex-col gap-2 px-5 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:px-8 sm:py-4 lg:px-12"
  >
    <a
      href="/"
      class="font-display hover:text-signal text-xl leading-none tracking-tight transition-colors"
      aria-label="Griffin Thomas, home"
    >
      Griffin Thomas
    </a>

    {/* Wraps onto its own line below the wordmark on narrow screens, which
        avoids a hamburger menu for what is only ever six short labels. */}
    <ul class="flex flex-wrap items-baseline gap-x-5 gap-y-1 sm:gap-x-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "data hover:text-ink transition-colors",
                isActive(link.href) ? "text-signal" : "text-graphite",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
