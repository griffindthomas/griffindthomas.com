---
import { loadLog } from "../lib/log";

/**
 * The Log link appears only once something has been written. An empty section
 * in the nav is a promise the site is not keeping, and this way publishing the
 * first entry is a one-file change with no nav edit to remember.
 */
const hasLog = (await loadLog()).length > 0;

const links = [
  { href: "/spotting", label: "Spotting" },
  { href: "/projects", label: "Projects" },
  ...(hasLog ? [{ href: "/log", label: "Log" }] : []),
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
/** Treat nested routes (/projects/foo) as their section being active. */
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-rule bg-paper/90 sticky top-0 z-40 border-b backdrop-blur-sm">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-[88rem] flex-col gap-2 px-5 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:px-8 sm:py-4 lg:px-12"
  >
    {/* Monogram plus wordmark. The mark is set in Newsreader rather than
        drawn, so it is the same letterforms as the headings and it stays
        crisp at any size. This is the ruled variant of the tab icon: a
        hairline box works on paper but vanishes at 16px in a browser tab,
        which is why the favicon is the solid version instead. */}
    <a
      href="/"
      class="group flex items-center gap-2.5 transition-colors"
      aria-label="Griffin Thomas, home"
    >
      <span
        class="border-rule text-ink group-hover:border-signal group-hover:text-signal font-display flex size-7 shrink-0 items-center justify-center border pt-px text-sm leading-none transition-colors"
        aria-hidden="true"
      >
        GT
      </span>
      <span
        class="font-display group-hover:text-signal text-xl leading-none tracking-tight transition-colors"
      >
        Griffin Thomas
      </span>
    </a>

    {/* Wraps onto its own line below the wordmark on narrow screens, which
        avoids a hamburger menu for what is only ever six short labels. */}
    <ul class="flex flex-wrap items-baseline gap-x-5 gap-y-1 sm:gap-x-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "data hover:text-ink transition-colors",
                isActive(link.href) ? "text-signal" : "text-graphite",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
