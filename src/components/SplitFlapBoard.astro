---
/**
 * Split-flap departure board.
 *
 * The thing that stops this being a widget bolted onto the page is that it is
 * not decorative text: every row is a photograph in the library, with the
 * registration read off that airframe, the date the shutter fired, and the
 * field it was shot at. It fills out on its own as photos are added.
 *
 * Rendered as printed card rather than as a glowing airport screen: paper
 * flaps, ink characters, a hairline seam across each one. Real Solari boards
 * are mechanical and matte, which is the version that belongs here.
 *
 * The modules and their animation belong to SplitFlapText. This component is
 * only the grid around them.
 */
import SplitFlapText from "./SplitFlapText.astro";
import type { Photo } from "../lib/photos";

interface Props {
  photos: Photo[];
  /** Rows to show. */
  limit?: number;
}

const { photos, limit = 10 } = Astro.props;

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

/**
 * Aircraft names have to survive a fixed module count, so trim them the way a
 * board would: the manufacturer is the least useful word when every row is an
 * aircraft, and the marketing name is the second least useful. "Boeing 787-9
 * Dreamliner" becomes "787-9". Truncating instead would leave "787-9 DREAML".
 */
function boardName(aircraft: string): string {
  const withoutMaker = aircraft.replace(
    /^(Boeing|Airbus|Embraer|Bombardier|Lockheed(\s+Martin)?|McDonnell\s+Douglas)\s+/i,
    "",
  );
  return withoutMaker.split(/\s+/)[0] ?? withoutMaker;
}

/**
 * One row per distinct aircraft, operator and field.
 *
 * Six photographs from one airshow would otherwise be six identical rows,
 * which is a worse board than three varied ones. The most recent frame of
 * each combination wins, and `photos` arrives newest first.
 */
const seen = new Set<string>();
const chosen: Photo[] = [];
for (const p of photos) {
  const where = p.field ? p.field.icao : p.data.location;
  const key = `${p.data.aircraft}|${p.data.operator}|${where}`;
  if (seen.has(key)) continue;
  seen.add(key);
  chosen.push(p);
  if (chosen.length >= limit) break;
}

const rows = chosen.map((p) => {
  const where = p.field ? p.field.icao : p.data.location.split(",")[0];
  // Year is deliberately absent: on a recent log it is the same on every row.
  const [, m, d] = p.data.shotAt.slice(0, 10).split("-");

  return {
    values: {
      date: `${d} ${MONTHS[Number(m) - 1]}`,
      reg: p.data.registration,
      type: boardName(p.data.aircraft),
      operator: p.data.operator,
      field: where,
    },
    // Screen readers get this sentence instead of fifty single characters.
    summary: [
      p.data.operator,
      p.data.aircraft,
      p.data.registration,
      `at ${p.placeLong || where}`,
      p.date,
    ]
      .filter(Boolean)
      .join(", "),
  };
});

/**
 * Module count per column, measured from the content rather than guessed.
 *
 * A real board has fixed-width modules, but choosing those widths by hand is
 * how words end up sliced in half. Taking the longest actual value means the
 * board is exactly as wide as it needs to be, nothing is ever truncated, and
 * it stays correct as photos are added.
 */
const COLUMNS = (
  [
    { id: "date", label: "Date" },
    { id: "reg", label: "Reg", hideBelow: "md" },
    { id: "type", label: "Aircraft" },
    { id: "operator", label: "Operator", hideBelow: "lg" },
    { id: "field", label: "Field" },
  ] as const
).map((col) => ({
  ...col,
  width: Math.max(col.label.length, ...rows.map((r) => r.values[col.id].length)),
}));
---

{
  rows.length > 0 && (
    <div class="board-wrap">
      <div class="board">
        <div class="board-head" aria-hidden="true">
          {COLUMNS.map((col) => (
            <span
              class="data col-label"
              data-hide={"hideBelow" in col ? col.hideBelow : undefined}
              style={`--modules:${col.width}`}
            >
              {col.label}
            </span>
          ))}
        </div>

        {rows.map((row, rowIndex) => (
          <div class="board-row">
            <span class="sr-only">{row.summary}</span>

            {COLUMNS.map((col) => (
              <span
                class="col"
                data-hide={"hideBelow" in col ? col.hideBelow : undefined}
                aria-hidden="true"
              >
                <SplitFlapText text={row.values[col.id]} width={col.width} group={rowIndex} />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  /* The board is wider than a phone. It scrolls inside its own box rather
     than making the whole page scroll sideways. */
  .board-wrap {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .board {
    /* Repeated from the .sf defaults so the header label width calculation
       below is done with the same numbers the modules are drawn at. */
    --flap-w: 0.95rem;
    --flap-gap: 2px;
    display: grid;
    gap: 0.375rem 1.25rem;
    min-width: max-content;
  }

  .board-head,
  .board-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .col {
    flex-shrink: 0;
  }

  /* Header labels are sized to the exact width of the module group they sit
     over, so the two line up. Without this they are spaced by their own text
     length and drift out of register with the columns below. */
  .col-label {
    flex-shrink: 0;
    width: calc(var(--modules) * var(--flap-w) + (var(--modules) - 1) * var(--flap-gap));
    color: var(--color-graphite);
  }

  @media (max-width: 1023px) {
    [data-hide="lg"] {
      display: none;
    }
  }

  @media (max-width: 767px) {
    [data-hide="md"] {
      display: none;
    }
  }
</style>
