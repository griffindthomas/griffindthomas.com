---
/**
 * The type board.
 *
 * A gallery is a folder. A collection is a set with holes in it, and the holes
 * are the interesting part, so the families already shot are inked in at the
 * top of the page and the ones still wanted sit at the bottom, under the
 * photographs. It fills in on its own: a family moves from one grid to the
 * other the moment a photo of it is imported, with nothing here to edit.
 *
 * The inked plates are also the gallery's type filter. They carry the same
 * `filter-chip` contract the filter bar uses, so clicking one filters the
 * photographs and the state stays in the URL.
 *
 * Every silhouette is generated from real dimensions and every one is drawn to
 * the SAME scale, so the sizes on the board can be compared: the 747 is four
 * times the aeroplane the F-35 is, and it looks it. See src/lib/planform.ts.
 */
import { AIRCRAFT_TYPES, SCALE_REFERENCE, familyForCode } from "../data/aircraft-types";
import { planform } from "../lib/planform";
import type { Photo } from "../lib/photos";

interface Props {
  photos: Photo[];
  /** Which half of the board this is. */
  mode: "caught" | "wanted";
}

const { photos, mode } = Astro.props;

/** Families in the library, and how many frames of each. */
const counts = new Map<string, number>();
for (const p of photos) {
  const family = familyForCode(p.data.typeCode);
  if (!family) continue;
  counts.set(family.id, (counts.get(family.id) ?? 0) + 1);
}

const draw = (t: (typeof AIRCRAFT_TYPES)[number]) =>
  planform(t.span, t.length, t.shape, SCALE_REFERENCE);

const caught = AIRCRAFT_TYPES.filter((t) => counts.has(t.id)).sort(
  (a, b) => (counts.get(b.id) ?? 0) - (counts.get(a.id) ?? 0) || a.name.localeCompare(b.name),
);
const wanted = AIRCRAFT_TYPES.filter((t) => !counts.has(t.id));

const shown = mode === "caught" ? caught : wanted;
---

{
  shown.length > 0 && (
    <section class="mt-16" aria-labelledby={`types-${mode}`}>
      <div class="border-rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b pb-2">
        <h2 id={`types-${mode}`} class="font-display text-3xl">
          {mode === "caught" ? "Types" : "Yet to photograph"}
        </h2>
        <p class="data">
          <span>
            {mode === "caught"
              ? `${caught.length} of ${AIRCRAFT_TYPES.length}`
              : `${wanted.length} to go`}
          </span>
          <span class="text-rule mx-2">/</span>
          <span>All drawn to one scale</span>
        </p>
      </div>

      <ul class="plates mt-8">
        {shown.map((type) => {
          const drawing = draw(type);
          const count = counts.get(type.id) ?? 0;
          const art = (
            <svg viewBox={drawing.viewBox} aria-hidden="true">
              {drawing.paths.map((d) => (
                <path d={d} />
              ))}
            </svg>
          );

          return (
            <li>
              {mode === "caught" ? (
                <button
                  type="button"
                  class="plate filter-chip"
                  data-group="family"
                  data-value={type.id}
                  aria-pressed="false"
                  aria-label={`Show only ${type.name}, ${count} ${count === 1 ? "photo" : "photos"}`}
                >
                  <span class="art inked">{art}</span>
                  <span class="data name">{type.name}</span>
                  <span class="data foot">
                    <span>{type.span} ft</span>
                    <span class="tally">{count}</span>
                  </span>
                </button>
              ) : (
                <span class="plate ghost" title={`Drawn as the ${type.drawn}`}>
                  <span class="art">{art}</span>
                  <span class="data name">{type.name}</span>
                  <span class="data foot">
                    <span>{type.span} ft</span>
                  </span>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 1.75rem 1rem;
  }

  .plate {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
  }

  /* No box behind the drawing. The aeroplane sits on the page, and because
     every drawing is to one scale, the empty space around a small one is the
     information: that is how much smaller it is. */
  .art {
    display: block;
    aspect-ratio: 1;
  }

  .art svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Caught: filled, the way a stamp is stuck in. */
  .inked path {
    fill: var(--color-chart);
    stroke: none;
  }

  /* Wanted: the same drawing in a tone that is barely there. Filled rather
     than outlined, because the aeroplane is built from overlapping shapes and
     stroking it draws every join as well as the outline. */
  .ghost path {
    fill: var(--color-rule);
    stroke: none;
  }

  .name {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-ink);
  }

  .ghost .name {
    color: var(--color-graphite);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.1rem;
    color: var(--color-graphite);
  }

  .tally {
    color: var(--color-signal);
  }

  button.plate {
    cursor: pointer;
  }
  button.plate:hover .inked path,
  button.plate:focus-visible .inked path {
    fill: var(--color-signal);
  }
  button.plate:hover .name,
  button.plate:focus-visible .name {
    color: var(--color-signal);
  }

  /* The selected family. Nothing moves when a filter goes on. */
  button.plate[aria-pressed="true"] .inked path {
    fill: var(--color-signal);
  }
  button.plate[aria-pressed="true"] .name {
    color: var(--color-signal);
  }
</style>
