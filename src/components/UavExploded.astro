---
/**
 * The modular UAV, coming apart as you scroll.
 *
 * There is no CAD model of the whole aeroplane to explode, so this is not
 * pretending to be one. It is a schematic assembly drawing: plan view, parts
 * separating along the axes they actually come apart on, numbered to a parts
 * list the way a drawing is. The point of the airframe was that it splits into
 * pieces that bolt together, and that is a thing a drawing can show and a
 * paragraph cannot.
 *
 * Scroll drives one custom property, `--t`, from 0 assembled to 1 apart.
 * Everything else is CSS reading that number, so there is one style write per
 * frame no matter how many parts are on the drawing.
 *
 * With JavaScript off, or under reduced motion, it renders fully apart and
 * static: the drawing is the content, the separating is the enhancement.
 */

/** Parts list. The numbers are the balloons on the drawing. */
const PARTS = [
  { n: 1, name: "Nose section", note: "Avionics and battery" },
  { n: 2, name: "Centre fuselage", note: "Wing saddle and boom socket" },
  { n: 3, name: "Outer wing panels", note: "One each side, off the centre" },
  { n: 4, name: "Tail boom", note: "Carbon fibre tube" },
  { n: 5, name: "V-tail", note: "Inverted, MQ-9 layout" },
  { n: 6, name: "Pusher motor", note: "Behind the tail" },
];
---

<section class="scene" data-uav aria-labelledby="exploded-heading">
  <div class="stage">
    <div class="border-rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b pb-2">
      <h2 id="exploded-heading" class="font-display text-2xl">How it comes apart</h2>
      <p class="data">59 in span / 6 assemblies</p>
    </div>

    <svg viewBox="0 0 340 220" class="drawing" role="img" aria-labelledby="exploded-alt">
      <title id="exploded-alt">
        Plan view of the airframe separated into its parts: nose section, centre
        fuselage with the wing centre on its saddle, two outer wing panels, the
        carbon tail boom, the inverted V-tail, and the pusher motor behind it.
      </title>

      {/* 1. Nose, forward. */}
      <g class="part nose">
        <path
          d="M 30 105 C 30 96, 38 90, 48 89 L 74 89 L 74 121 L 48 121 C 38 120, 30 114, 30 105 Z"
        />
        <g class="balloon" transform="translate(46 74)">
          <circle r="7.5"></circle>
          <text y="2.6">1</text>
        </g>
      </g>

      {/* 2. Centre fuselage, with the wing centre section on its saddle.
          The two are one part in the drawing because a plan view cannot show
          the wing lifting off: separating them along the only axes there are
          slides one straight through the other. */}
      <g class="part hull">
        <path d="M 76 89 L 158 91 L 165 100 L 165 110 L 158 119 L 76 121 Z"></path>
        <path d="M 88 88 L 126 88 L 126 122 L 88 122 Z"></path>
        {/* The saddle, and the rib the outer panels bolt to. */}
        <path class="hair" d="M 88 88 L 88 122 M 126 88 L 126 122"></path>
        <g class="balloon" transform="translate(146 138)">
          <circle r="7.5"></circle>
          <text y="2.6">2</text>
        </g>
      </g>

      {/* 3. Outer panels, coming off the centre section each side. */}
      <g class="part panel left">
        <path d="M 88 88 L 126 88 L 112 22 L 88 20 Z"></path>
        {/* Aileron. Dashed, because it was never finished. */}
        <path class="unbuilt" d="M 121.1 64.9 L 112.7 25.3 L 104.7 25.3 L 113.1 64.9 Z"></path>
        <g class="balloon" transform="translate(74 44)">
          <circle r="7.5"></circle>
          <text y="2.6">3</text>
        </g>
      </g>

      <g class="part panel right">
        <path d="M 88 122 L 126 122 L 112 188 L 88 190 Z"></path>
        <path class="unbuilt" d="M 121.1 145.1 L 112.7 184.7 L 104.7 184.7 L 113.1 145.1 Z"></path>
        <g class="balloon" transform="translate(74 166)">
          <circle r="7.5"></circle>
          <text y="2.6">3</text>
        </g>
      </g>

      {/* 4. Boom. */}
      <g class="part boom">
        <path d="M 163 100 L 252 100 L 252 110 L 163 110 Z"></path>
        <g class="balloon" transform="translate(205 128)">
          <circle r="7.5"></circle>
          <text y="2.6">4</text>
        </g>
      </g>

      {/* 5. V-tail, inverted, so in plan it opens aft. */}
      <g class="part tail">
        <path d="M 248 104 L 292 74 L 300 80 L 258 110 Z"></path>
        <path d="M 248 106 L 292 136 L 300 130 L 258 110 Z"></path>
        <path class="unbuilt" d="M 292 74 L 300 80 L 296 86 L 288 80 Z"></path>
        <path class="unbuilt" d="M 292 136 L 300 130 L 296 124 L 288 130 Z"></path>
        <g class="balloon" transform="translate(276 105)">
          <circle r="7.5"></circle>
          <text y="2.6">5</text>
        </g>
      </g>

      {/* 6. Motor and pusher prop, blades edge on. */}
      <g class="part prop">
        <path d="M 300 100 L 312 101 L 312 109 L 300 110 Z"></path>
        <path d="M 314 105 L 318 66 L 322 66 L 318 105 Z"></path>
        <path d="M 314 105 L 318 144 L 322 144 L 318 105 Z"></path>
        <g class="balloon" transform="translate(318 158)">
          <circle r="7.5"></circle>
          <text y="2.6">6</text>
        </g>
      </g>
    </svg>

    <ol class="parts">
      {
        PARTS.map((part) => (
          <li>
            <span class="num">{String(part.n).padStart(2, "0")}</span>
            <span class="pname">{part.name}</span>
            <span class="pnote">{part.note}</span>
          </li>
        ))
      }
    </ol>

    <p class="data note">
      <span class="dash" aria-hidden="true"></span>
      Dashed: the control surfaces, which were never completed
    </p>

    <p class="text-graphite mt-4 text-sm">
      A schematic rather than a model. The aeroplane was never drawn in full in
      CAD, so this is the layout as it was built, not a render of a file.
    </p>
  </div>
</section>

<style>
  .scene {
    /* Height is added by the script. Without it the drawing is simply here,
       already apart, and the page reads normally. */
    --t: 1;
    margin-top: 4rem;
  }

  .drawing {
    display: block;
    width: 100%;
    max-width: 52rem;
    margin: 1.5rem auto 0;
    overflow: visible;
  }

  .part path {
    fill: var(--color-paper-sunk);
    stroke: var(--color-chart);
    stroke-width: 1.1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .hair {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 0.8;
  }

  .unbuilt {
    fill: none;
    stroke: var(--color-signal);
    stroke-dasharray: 3 2.5;
  }

  /* Balloons appear once the parts have opened up enough to point at. */
  .balloon {
    opacity: clamp(0, calc((var(--t) - 0.3) * 4), 1);
  }
  .balloon circle {
    fill: var(--color-paper);
    stroke: var(--color-rule);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }
  .balloon text {
    fill: var(--color-graphite);
    font-family: var(--font-mono);
    font-size: 8px;
    text-anchor: middle;
  }

  /* The separation itself. One property drives all of it, and each part only
     moves along the axis it actually comes off on. */
  .nose {
    transform: translateX(calc(var(--t) * -54px));
  }
  .panel.left {
    transform: translateY(calc(var(--t) * -46px));
  }
  .panel.right {
    transform: translateY(calc(var(--t) * 46px));
  }
  .boom {
    transform: translateX(calc(var(--t) * 34px));
  }
  .tail {
    transform: translateX(calc(var(--t) * 62px));
  }
  .prop {
    transform: translateX(calc(var(--t) * 86px));
  }

  .parts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.4rem 2rem;
    margin-top: 2rem;
  }

  .parts li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0 0.5rem;
    align-items: baseline;
    border-top: 1px solid var(--color-rule);
    padding-top: 0.4rem;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-signal);
  }

  .pname {
    color: var(--color-ink);
  }

  .pnote {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-graphite);
  }

  .note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    color: var(--color-signal);
  }

  .dash {
    display: block;
    width: 2rem;
    height: 0;
    border-top: 1px dashed var(--color-signal);
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>("[data-uav]");

  if (scene && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const stage = scene.querySelector<HTMLElement>(".stage");

    if (stage) {
      // The tall box and the sticky drawing are added here rather than in the
      // stylesheet, so a reader without this script gets the finished drawing
      // instead of a screen and a half of empty scrolling.
      scene.style.height = "200vh";
      stage.style.position = "sticky";
      stage.style.top = "6rem";
      scene.style.setProperty("--t", "0");

      let queued = false;

      const draw = () => {
        queued = false;
        const box = scene.getBoundingClientRect();
        // How far through the tall box the sticky drawing has travelled.
        const travel = scene.offsetHeight - stage.offsetHeight;
        if (travel <= 0) {
          scene.style.setProperty("--t", "1");
          return;
        }
        const t = Math.min(1, Math.max(0, (96 - box.top) / travel));
        scene.style.setProperty("--t", t.toFixed(3));
      };

      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(draw);
      };

      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      draw();
    }
  }
</script>
