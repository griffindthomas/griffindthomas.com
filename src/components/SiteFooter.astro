---
import { PROFILES, RESUME_PDF, SITE } from "../config/site";

const year = new Date().getFullYear();

// Real profiles, from one config file. These used to be bare platform home
// pages, which is a broken link with a valid URL.
const elsewhere = [
  ...PROFILES.map((p) => ({ href: p.href, label: p.label, external: true })),
  { href: "/resume", label: "Resume", external: false },
  { href: "/contact", label: "Contact", external: false },
];
---

<footer class="border-rule mt-24 border-t">
  <div
    class="mx-auto flex max-w-[88rem] flex-col gap-6 px-5 py-8 sm:px-8 md:flex-row md:items-baseline md:justify-between lg:px-12"
  >
    <div class="data">
      <p>&copy; {year} {SITE.name}</p>
      <p class="mt-1" aria-hidden="true">
        N{SITE.base.lat.toFixed(4)} W{Math.abs(SITE.base.lon).toFixed(4)}
      </p>
    </div>

    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              class="data hover:text-signal transition-colors"
              {...link.external
                ? { target: "_blank", rel: "me noopener noreferrer" }
                : {}}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={RESUME_PDF} download class="data hover:text-signal transition-colors">
          PDF
        </a>
      </li>
    </ul>

    {/* Decorative aviation detail. Local time sits above Zulu the way a clock
        pair does on a dispatch wall: the one you live by, and the one that is
        the same everywhere. */}
    <div class="data md:text-right" aria-hidden="true">
      <p>
        <span class="text-rule">LCL</span>
        <span class="ml-2" data-local>--:--:--</span>
      </p>
      <p class="mt-1">
        <span class="text-rule">UTC</span>
        <span class="ml-2" data-zulu>--:--:--Z</span>
      </p>
    </div>
  </div>
</footer>

<script>
  // Progressive enhancement: the markup ships placeholders, and this only
  // upgrades them if JS runs.
  const zulu = document.querySelector<HTMLElement>("[data-zulu]");
  const local = document.querySelector<HTMLElement>("[data-local]");

  if (zulu || local) {
    const pad = (n: number) => String(n).padStart(2, "0");

    /**
     * The reader's own zone, taken from the browser rather than hardcoded to
     * his. Everyone gets their own local clock next to Zulu, which is the
     * pairing that is actually useful: the difference between the two is the
     * reader's offset, not a number about somebody else.
     *
     * Resolved once. It cannot change while the page is open, and asking for
     * it every second would be wasteful.
     */
    const zone = (() => {
      try {
        return (
          new Intl.DateTimeFormat(undefined, { timeZoneName: "short" })
            .formatToParts(new Date())
            .find((part) => part.type === "timeZoneName")?.value ?? ""
        );
      } catch {
        // Some very old engines have no timeZoneName support. The clock is
        // still correct, it just goes unlabelled.
        return "";
      }
    })();

    const tick = () => {
      const now = new Date();

      if (zulu) {
        zulu.textContent = `${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(
          now.getUTCSeconds(),
        )}Z`;
      }

      if (local) {
        const time = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
        local.textContent = zone ? `${time} ${zone}` : time;
      }
    };

    tick();
    const timer = window.setInterval(tick, 1000);

    // Astro ships a persistent-island/view-transition friendly teardown hook;
    // clearing avoids stacking intervals across client-side navigations.
    document.addEventListener("astro:before-swap", () => window.clearInterval(timer), {
      once: true,
    });
  }
</script>
