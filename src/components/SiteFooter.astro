---
import { PROFILES, RESUME_PDF, SITE } from "../config/site";

const year = new Date().getFullYear();

// Real profiles, from one config file. These used to be bare platform home
// pages, which is a broken link with a valid URL.
const elsewhere = [
  ...PROFILES.map((p) => ({ href: p.href, label: p.label, external: true })),
  { href: "/resume", label: "Resume", external: false },
  { href: "/contact", label: "Contact", external: false },
];
---

<footer class="border-rule mt-24 border-t">
  <div
    class="mx-auto flex max-w-[88rem] flex-col gap-6 px-5 py-8 sm:px-8 md:flex-row md:items-baseline md:justify-between lg:px-12"
  >
    <p class="data">&copy; {year} {SITE.name}</p>

    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              class="data hover:text-signal transition-colors"
              {...link.external
                ? { target: "_blank", rel: "me noopener noreferrer" }
                : {}}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={RESUME_PDF} download class="data hover:text-signal transition-colors">
          PDF
        </a>
      </li>
    </ul>

    {/* Decorative aviation detail: Zulu (UTC) clock over the home field. */}
    <p class="data" aria-hidden="true">
      <span>N{SITE.base.lat.toFixed(4)} W{Math.abs(SITE.base.lon).toFixed(4)}</span>
      <span class="text-rule mx-2">/</span>
      <span data-zulu>--:--:--Z</span>
    </p>
  </div>
</footer>

<script>
  // Progressive enhancement: the markup ships a placeholder, and this only
  // upgrades it if JS runs. Zulu time is what aviation actually uses, so the
  // clock is deliberately UTC rather than the visitor's local time.
  const el = document.querySelector<HTMLElement>("[data-zulu]");

  if (el) {
    const pad = (n: number) => String(n).padStart(2, "0");

    const tick = () => {
      const now = new Date();
      el.textContent = `${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(
        now.getUTCSeconds(),
      )}Z`;
    };

    tick();
    const timer = window.setInterval(tick, 1000);

    // Astro ships a persistent-island/view-transition friendly teardown hook;
    // clearing avoids stacking intervals across client-side navigations.
    document.addEventListener("astro:before-swap", () => window.clearInterval(timer), {
      once: true,
    });
  }
</script>
