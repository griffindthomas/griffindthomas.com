---
/**
 * One run of split-flap modules.
 *
 * This is the only component that renders flaps and the only one that
 * animates them: its script scans the whole document for flap groups, so a
 * page can use any number of these, in any layout, and they all cascade from
 * one animation loop rather than one timer each.
 *
 * The final text is always server-rendered into the modules. With JavaScript
 * off, or under reduced motion, this is simply text in boxes. The flipping is
 * pure enhancement, never the thing that puts the words there.
 */
interface Props {
  text: string;
  /**
   * Pad to exactly this many modules and keep them as one unbreakable run.
   * Used by the departure board, where every row must occupy the same grid
   * whether or not there is anything to put in it. Omit for free text, which
   * is grouped by word so a wrap never splits one down the middle.
   */
  width?: number;
  /** Extra classes on the wrapper, for per-context module sizing. */
  class?: string;
  /** Ordering hint so a grid of these cascades in reading order. */
  group?: number;
}

const { text, width, class: className = "", group = 0 } = Astro.props;

const upper = text.toUpperCase();

/**
 * Fixed width means one padded run. Free text is split on spaces into
 * separate runs, with a narrow spacer between them: real boards do not wrap,
 * but a photo caption in a grid column has to.
 */
const runs: string[] = width === undefined ? upper.split(/\s+/).filter(Boolean) : [upper.padEnd(width, " ")];
---

<span class:list={["sf", className]} data-flap-group data-group-order={group}>
  {
    runs.map((run, i) => (
      <>
        {i > 0 && <span class="sf-space" aria-hidden="true" />}
        <span class="sf-word">
          {run.split("").map((ch) => (
            <span class="flap" data-flap>
              {ch === " " ? " " : ch}
            </span>
          ))}
        </span>
      </>
    ))
  }
</span>

<script>
  /**
   * Drives every flap group on the page from a single animation loop.
   *
   * One timer per module would mean several hundred of them on the gallery,
   * all drifting apart from each other. One loop keeps the whole page on the
   * same cadence, which is what makes separate groups look like one machine.
   */
  const groups = [...document.querySelectorAll<HTMLElement>("[data-flap-group]")];

  if (groups.length > 0) {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Landing on the real character is the point, so the deck it cycles
    // through is the set actually used plus the alphabet.
    const DECK = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 /-:.".split("");

    interface Cell {
      el: HTMLElement;
      /** The group this module belongs to, so a group knows when it is done. */
      owner: HTMLElement;
      target: string;
      /** Changes still to burn before this module settles. */
      remaining: number;
      /** Frame this module starts moving on. */
      start: number;
    }

    let cells: Cell[] = [];
    let running = false;
    let frame = 0;

    /** Modules still in flight per group, so a group is never restarted while
     *  it is already shuffling. */
    const busy = new Map<HTMLElement, number>();

    function finish(cell: Cell) {
      cell.el.textContent = cell.target;
      cell.el.removeAttribute("data-flipping");
      const left = (busy.get(cell.owner) ?? 1) - 1;
      if (left <= 0) busy.delete(cell.owner);
      else busy.set(cell.owner, left);
    }

    const tick = () => {
      let active = 0;

      // Every module changes on the same cadence, a few frames apart, which
      // reads as mechanical rather than as a blur.
      for (const cell of cells) {
        if (cell.remaining <= 0) continue;
        active += 1;
      }

      if (active === 0) {
        running = false;
        cells = [];
        return;
      }

      frame += 1;
      if (frame % 3 === 0) {
        for (const cell of cells) {
          if (cell.remaining <= 0 || frame < cell.start) continue;
          cell.remaining -= 1;

          if (cell.remaining <= 0) {
            finish(cell);
          } else {
            cell.el.textContent = DECK[Math.floor(Math.random() * DECK.length)];
            cell.el.setAttribute("data-flipping", "");
          }
        }
      }

      requestAnimationFrame(tick);
    };

    /**
     * Force every module to its real character, whatever state it is in.
     *
     * This matters more than it looks. While a module is flipping it is
     * displaying a RANDOM letter, so anything that stops the loop leaves the
     * reader looking at gibberish where a caption should be. The animation
     * runs on requestAnimationFrame, which browsers suspend for background
     * tabs, so that is not hypothetical.
     */
    function settleAll() {
      for (const cell of cells) {
        if (cell.remaining <= 0) continue;
        cell.remaining = 0;
        finish(cell);
      }
    }

    function enqueue(group: HTMLElement) {
      const order = Number(group.dataset.groupOrder ?? 0);
      const flaps = [...group.querySelectorAll<HTMLElement>("[data-flap]")];

      busy.set(group, flaps.length);

      flaps.forEach((el, i) => {
        cells.push({
          el,
          owner: group,
          // Read the SETTLED text, never a character mid-flip. A group is
          // only ever enqueued when it is not already busy, which is what
          // guarantees this is the real value and not a random letter that
          // would then get baked in as the target.
          target: el.textContent ?? "",
          remaining: 6 + Math.floor(Math.random() * 10),
          // Left to right within a group, and later groups start later, so a
          // grid of these cascades in reading order.
          start: frame + i * 1.5 + order * 5,
        });
      });

      // Backstop on a timer rather than a frame, because timers still fire
      // when frames do not. A settled board that never animated is fine; a
      // board frozen mid-flip showing nonsense is not.
      window.setTimeout(settleAll, 4000);

      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    }

    // Leaving the tab suspends the frame loop, so snap to the real text on
    // the way out rather than coming back to a half-scrambled page.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) settleAll();
    });

    /**
     * Loose-flap rattle while the page scrolls.
     *
     * Driven by scroll VELOCITY, not position, so the modules only stir when
     * the page is actually moving and settle the moment it stops. The angle
     * is written to one custom property on the root element, and every module
     * reads it from CSS: one style write per frame regardless of how many
     * flaps are on the page, and the transforms themselves are composited.
     * Setting a transform on each of several hundred modules individually
     * would be an obvious way to make scrolling stutter.
     */
    if (!calm) {
      // Big enough to actually see. A flap is only about 20px tall, so a
      // small angle is a sub-pixel change; this is a swing, not a nudge.
      const MAX_TILT = 38;
      let lastY = window.scrollY;
      let lastT = performance.now();
      let tilt = 0;
      let settling = false;

      const settle = () => {
        // Ease back to flat, and stop asking for frames once it is there.
        tilt *= 0.82;
        if (Math.abs(tilt) < 0.05) {
          tilt = 0;
          settling = false;
        }
        document.documentElement.style.setProperty("--jig", tilt.toFixed(2));
        if (settling) requestAnimationFrame(settle);
      };

      let flatten = 0;

      window.addEventListener(
        "scroll",
        () => {
          const now = performance.now();
          const dt = now - lastT;
          if (dt < 8) return;

          const dy = window.scrollY - lastY;
          lastY = window.scrollY;
          lastT = now;

          // Pixels per millisecond, scaled into degrees and clamped so a
          // flung scroll does not fold the modules flat.
          const velocity = dy / dt;
          tilt = Math.max(-MAX_TILT, Math.min(MAX_TILT, velocity * 22));
          document.documentElement.style.setProperty("--jig", tilt.toFixed(2));

          // Same reasoning as the flip backstop: the easing runs on frames,
          // so if frames stop the modules would stay permanently tilted. A
          // timer guarantees they end up flat.
          window.clearTimeout(flatten);
          flatten = window.setTimeout(() => {
            tilt = 0;
            settling = false;
            document.documentElement.style.setProperty("--jig", "0");
          }, 500);

          if (!settling) {
            settling = true;
            requestAnimationFrame(settle);
          }
        },
        { passive: true },
      );
    }

    if (!calm) {
      /*
       * Re-shuffles every time a group comes back into view, so scrolling
       * away and back replays it rather than leaving a board that only ever
       * moved once.
       *
       * The group stays observed, and the `busy` guard is what makes that
       * safe: without it, a group scrolled past quickly could be enqueued
       * again while still mid-flip, and the second pass would capture a
       * random in-flight character as its target and freeze it there.
       */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const group = entry.target as HTMLElement;
            if (busy.has(group)) continue;
            enqueue(group);
          }
        },
        { threshold: 0.2 },
      );

      for (const group of groups) observer.observe(group);
    }
  }
</script>
