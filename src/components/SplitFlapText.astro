---
/**
 * One run of split-flap modules.
 *
 * This is the only component that renders flaps and the only one that
 * animates them: its script scans the whole document for flap groups, so a
 * page can use any number of these, in any layout, and they all cascade from
 * one animation loop rather than one timer each.
 *
 * The final text is always server-rendered into the modules. With JavaScript
 * off, or under reduced motion, this is simply text in boxes. The flipping is
 * pure enhancement, never the thing that puts the words there.
 */
interface Props {
  text: string;
  /**
   * Pad to exactly this many modules and keep them as one unbreakable run.
   * Used by the departure board, where every row must occupy the same grid
   * whether or not there is anything to put in it. Omit for free text, which
   * is grouped by word so a wrap never splits one down the middle.
   */
  width?: number;
  /** Extra classes on the wrapper, for per-context module sizing. */
  class?: string;
  /** Ordering hint so a grid of these cascades in reading order. */
  group?: number;
}

const { text, width, class: className = "", group = 0 } = Astro.props;

const upper = text.toUpperCase();

/**
 * Fixed width means one padded run. Free text is split on spaces into
 * separate runs, with a narrow spacer between them: real boards do not wrap,
 * but a photo caption in a grid column has to.
 */
const runs: string[] = width === undefined ? upper.split(/\s+/).filter(Boolean) : [upper.padEnd(width, " ")];

/**
 * What an empty module holds. A non-breaking space, and not for typography.
 *
 * A module whose text is an ordinary space has no rendered content, so the
 * flex box synthesises a baseline from its own box instead of taking one from
 * a glyph, and it sits two pixels off from a module holding a letter. Every
 * module that cycles through a blank while flipping therefore nudges the line
 * it is on, and everything below it on the page moves. A non-breaking space
 * is content, so the baseline never changes and the line stays put.
 */
const BLANK = "\u00A0";
---

<span class:list={["sf", className]} data-flap-group data-group-order={group}>
  {
    runs.map((run, i) => (
      <>
        {i > 0 && <span class="sf-space" aria-hidden="true" />}
        <span class="sf-word">
          {run.split("").map((ch) => (
            <span class="flap" data-flap>
              {ch === " " ? BLANK : ch}
            </span>
          ))}
        </span>
      </>
    ))
  }
</span>

<script>
  /**
   * Drives every flap group on the page from a single animation loop.
   *
   * One timer per module would mean several hundred of them on the gallery,
   * all drifting apart from each other. One loop keeps the whole page on the
   * same cadence, which is what makes separate groups look like one machine.
   */
  const groups = [...document.querySelectorAll<HTMLElement>("[data-flap-group]")];

  if (groups.length > 0) {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Landing on the real character is the point, so the deck it cycles
    // through is the set actually used plus the alphabet.
    // No blank in the deck. A module that lands on one mid-flip moves the
    // line it sits on, for the reason described above the markup.
    const DECK = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/-:.".split("");
    const junk = () => DECK[Math.floor(Math.random() * DECK.length)];
    /** Matches the BLANK the server rendered into empty modules. */
    const BLANK = "\u00A0";

    /**
     * The real character of every module, stamped onto the module itself.
     *
     * Everything below this line displays temporary nonsense at some point,
     * so there has to be one place that always holds the truth. Reading it
     * back off the element means a module can be restored from any state by
     * anything, without a variable somewhere having to still be correct.
     * The server-rendered text is that truth.
     */
    const modules = new Map<HTMLElement, HTMLElement[]>();
    for (const group of groups) {
      const flaps = [...group.querySelectorAll<HTMLElement>("[data-flap]")];
      for (const el of flaps) {
        // Trimmed, because the character sits on its own line in the markup
        // and the raw text node carries the indentation with it. `trim` also
        // eats the non-breaking space a padding module holds, so a blank
        // normalises back to one rather than to nothing.
        const ch = (el.textContent ?? "").trim();
        el.dataset.ch = ch === "" ? BLANK : ch;
      }
      modules.set(group, flaps);
    }

    function reset(el: HTMLElement) {
      el.textContent = el.dataset.ch ?? "";
      el.removeAttribute("data-flipping");
    }

    /** Modules the shuffle currently owns, so the rattle leaves them alone. */
    const shuffling = new Set<HTMLElement>();
    /** Modules showing junk because the page is moving. */
    const rattled = new Set<HTMLElement>();
    /** Groups on screen. Scrambling one nobody can see is a wasted write. */
    const onscreen = new Set<HTMLElement>();

    function unrattle() {
      for (const el of rattled) reset(el);
      rattled.clear();
    }

    interface Cell {
      el: HTMLElement;
      /** The group this module belongs to, so a group knows when it is done. */
      owner: HTMLElement;
      target: string;
      /** Changes still to burn before this module settles. */
      remaining: number;
      /** Frame this module starts moving on. */
      start: number;
    }

    let cells: Cell[] = [];
    let running = false;
    let frame = 0;

    /** Modules still in flight per group, so a group is never restarted while
     *  it is already shuffling. */
    const busy = new Map<HTMLElement, number>();

    function finish(cell: Cell) {
      cell.el.textContent = cell.target;
      cell.el.removeAttribute("data-flipping");
      shuffling.delete(cell.el);
      const left = (busy.get(cell.owner) ?? 1) - 1;
      if (left <= 0) busy.delete(cell.owner);
      else busy.set(cell.owner, left);
    }

    const tick = () => {
      let active = 0;

      // Every module changes on the same cadence, a few frames apart, which
      // reads as mechanical rather than as a blur.
      for (const cell of cells) {
        if (cell.remaining <= 0) continue;
        active += 1;
      }

      if (active === 0) {
        running = false;
        cells = [];
        return;
      }

      frame += 1;
      if (frame % 3 === 0) {
        for (const cell of cells) {
          if (cell.remaining <= 0 || frame < cell.start) continue;
          cell.remaining -= 1;

          if (cell.remaining <= 0) {
            finish(cell);
          } else {
            cell.el.textContent = junk();
            cell.el.setAttribute("data-flipping", "");
          }
        }
      }

      requestAnimationFrame(tick);
    };

    /**
     * Force every module to its real character, whatever state it is in.
     *
     * This matters more than it looks. While a module is flipping it is
     * displaying a RANDOM letter, so anything that stops the loop leaves the
     * reader looking at gibberish where a caption should be. The animation
     * runs on requestAnimationFrame, which browsers suspend for background
     * tabs, so that is not hypothetical.
     */
    function settleAll() {
      for (const cell of cells) {
        if (cell.remaining <= 0) continue;
        cell.remaining = 0;
        finish(cell);
      }
      unrattle();
    }

    function enqueue(group: HTMLElement) {
      const order = Number(group.dataset.groupOrder ?? 0);
      const flaps = modules.get(group) ?? [];

      busy.set(group, flaps.length);

      flaps.forEach((el, i) => {
        // The rattle hands the module over rather than fighting the shuffle
        // for it. Whichever finishes last would otherwise decide the text.
        rattled.delete(el);
        shuffling.add(el);

        cells.push({
          el,
          owner: group,
          // The stamped character, not whatever is on screen. On screen it
          // may well be junk from the rattle or from a flip still in flight,
          // and reading that would bake the junk in as the target.
          target: el.dataset.ch ?? "",
          remaining: 6 + Math.floor(Math.random() * 10),
          // Left to right within a group, and later groups start later, so a
          // grid of these cascades in reading order.
          start: frame + i * 1.5 + order * 5,
        });
      });

      // Backstop on a timer rather than a frame, because timers still fire
      // when frames do not. A settled board that never animated is fine; a
      // board frozen mid-flip showing nonsense is not.
      window.setTimeout(settleAll, 4000);

      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    }

    // Leaving the tab suspends the frame loop, so snap to the real text on
    // the way out rather than coming back to a half-scrambled page.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) settleAll();
    });

    /**
     * Loose-flap rattle while the page scrolls.
     *
     * Driven by scroll VELOCITY, not position, so the modules only stir when
     * the page is actually moving and settle the moment it stops. The angle
     * is written to one custom property on the root element, and every module
     * reads it from CSS: one style write per frame regardless of how many
     * flaps are on the page, and the transforms themselves are composited.
     * Setting a transform on each of several hundred modules individually
     * would be an obvious way to make scrolling stutter.
     */
    if (!calm) {
      // Big enough to actually see. A flap is only about 20px tall, so a
      // small angle is a sub-pixel change; this is a swing, not a nudge.
      const MAX_TILT = 38;
      /**
       * Floor on the swing, and the reason this works at all.
       *
       * Scaling purely by velocity looked right on paper and produced about
       * two degrees in practice, which is invisible. How much scroll arrives
       * per event varies enormously between a wheel notch, a trackpad glide
       * and a touch flick, so velocity alone cannot be trusted to land
       * anywhere near the intended range. Any scroll at all now moves the
       * modules by at least this much, and speed only decides how much
       * further past it they swing.
       */
      const MIN_TILT = 16;
      let lastY = window.scrollY;
      let lastT = performance.now();
      let tilt = 0;
      let settling = false;

      /**
       * Characters shaken loose while the page moves.
       *
       * A module that only tilts is a box that tilts. A module that tilts and
       * shows the wrong character is a flap that has been knocked off its
       * detent, which is the thing being imitated. The junk is never allowed
       * to outlive the movement: one step's worth is on screen at a time, and
       * everything goes back to the stamped character as the page settles.
       */
      const SCRAMBLE_SHARE = 0.12;
      // Below this the page has all but stopped, so the text is readable
      // again before the tilt has finished easing out.
      const SCRAMBLE_FLOOR = MIN_TILT * 0.4;
      let rattleFrame = 0;

      function scramble() {
        // Only what is on screen. On the gallery there are several hundred
        // modules and a handful of them are in view.
        const pool: HTMLElement[] = [];
        for (const group of onscreen) {
          const flaps = modules.get(group);
          if (flaps) pool.push(...flaps);
        }

        // Put the previous step back first. Nothing accumulates, so no module
        // can be left holding a random letter once scrolling stops.
        unrattle();
        if (pool.length === 0) return;

        const strength = Math.min(1, Math.abs(tilt) / MAX_TILT);
        const count = Math.max(1, Math.round(pool.length * SCRAMBLE_SHARE * strength));

        for (let i = 0; i < count; i += 1) {
          const el = pool[Math.floor(Math.random() * pool.length)];
          // Blank padding modules have nothing to disturb, and anything the
          // shuffle is holding belongs to the shuffle.
          if (!el || shuffling.has(el) || rattled.has(el) || el.dataset.ch === BLANK) continue;
          el.textContent = junk();
          el.setAttribute("data-flipping", "");
          rattled.add(el);
        }
      }

      const settle = () => {
        // Ease back to flat, and stop asking for frames once it is there.
        tilt *= 0.88;
        if (Math.abs(tilt) < 0.05) {
          tilt = 0;
          settling = false;
        }
        document.documentElement.style.setProperty("--jig", tilt.toFixed(2));

        rattleFrame += 1;
        if (Math.abs(tilt) < SCRAMBLE_FLOOR) unrattle();
        else if (rattleFrame % 4 === 0) scramble();

        if (settling) requestAnimationFrame(settle);
      };

      let flatten = 0;

      window.addEventListener(
        "scroll",
        () => {
          const now = performance.now();
          const dt = now - lastT;
          if (dt < 8) return;

          const dy = window.scrollY - lastY;
          // A scroll event that did not move the page is not a scroll.
          // Returning without touching lastY/lastT keeps the next real move
          // measured against where it actually started.
          if (dy === 0) return;

          lastY = window.scrollY;
          lastT = now;

          // Direction decides which way they swing; speed only decides how
          // far past the floor they go.
          const speed = Math.abs(dy) / dt;
          const amount = Math.min(MAX_TILT, Math.max(MIN_TILT, speed * 30));
          tilt = dy > 0 ? amount : -amount;
          document.documentElement.style.setProperty("--jig", tilt.toFixed(2));

          // Same reasoning as the flip backstop: the easing runs on frames,
          // so if frames stop the modules would stay permanently tilted. A
          // timer guarantees they end up flat.
          window.clearTimeout(flatten);
          flatten = window.setTimeout(() => {
            tilt = 0;
            settling = false;
            document.documentElement.style.setProperty("--jig", "0");
            unrattle();
          }, 500);

          if (!settling) {
            settling = true;
            requestAnimationFrame(settle);
          }
        },
        { passive: true },
      );
    }

    if (!calm) {
      /*
       * Re-shuffles every time a group comes back into view, so scrolling
       * away and back replays it rather than leaving a board that only ever
       * moved once.
       *
       * The group stays observed, and the `busy` guard is what makes that
       * safe: without it, a group scrolled past quickly could be enqueued
       * again while still mid-flip, and the second pass would capture a
       * random in-flight character as its target and freeze it there.
       */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const group = entry.target as HTMLElement;
            // Doubles as the register of what is on screen, which is what
            // keeps the scroll rattle from scrambling modules nobody is
            // looking at.
            if (!entry.isIntersecting) {
              onscreen.delete(group);
              continue;
            }
            onscreen.add(group);
            if (busy.has(group)) continue;
            enqueue(group);
          }
        },
        { threshold: 0.2 },
      );

      for (const group of groups) observer.observe(group);
    }
  }
</script>
