---
// Swim progression plotted as ink on paper.
//
// 121 swims is far too many to list, and a table of times says nothing. So:
// every swim is a faint hollow mark (the volume, the grind), and the personal
// bests are drawn bold and connected - the record line cutting through the
// noise. Faster is UP, so improvement reads as ascent.
//
// TWO COURSES, TWO SCALES. Short course yards and long course metres are not
// comparable numbers: a 31.12 metres 50 is a better swim than a 33 yards 50,
// and forcing both onto one axis would shove long course to the floor and
// flatten the short course line into nothing. Each course therefore gets its
// own y-scale over the same plot area, labelled on its own side. Gridlines are
// shared because both scales are linear over the same pixels, so a single line
// carries a meaningful value for each. What the reader compares is the SHAPE
// of the two lines, which is the honest comparison.
//
// Server-rendered SVG. No chart library, no client JS required to read it;
// the hover readout is progressive enhancement only.
import data from "../data/swims.json";
import { profile } from "../config/site";

interface Swim {
  event: string;
  course: string;
  time: string;
  seconds: number;
  meet: string;
  date: string;
  era: string;
  isPB: boolean;
}

const swims = data.swims as Swim[];

/** Orange is short course, blue is long course, everywhere on this chart. */
const COURSES = [
  { id: "SCY", label: "Short course yards", colour: "var(--color-signal)" },
  { id: "LCM", label: "Long course metres", colour: "var(--color-chart)" },
];

/**
 * Career markers. These are what turn the plot into a story rather than a
 * line: the surgery in particular is invisible in the personal-best line
 * (a record simply holds while you are out) and only shows up in the faint
 * marks - an eight-month gap in racing, then a return several seconds down.
 *
 * `dy` staggers the labels so they do not collide when markers fall close
 * together on the shared time axis.
 */
const markers = [
  { date: data.summary.moveDate as string, label: "moved to NH", dy: 10 },
  { date: "2024-05-01", label: "shoulder surgery", dy: 26 },
];

const W = 860;
const H = 260;
// Right margin matches the left: the long course axis is labelled over there.
const M = { top: 18, right: 54, bottom: 30, left: 54 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;

// Time axis derived from the data, not hardcoded, so adding a season does not
// silently push swims off the right-hand edge.
const allDates = swims.map((s) => Date.parse(s.date));
const padMs = 75 * 24 * 3600 * 1000;
const t0 = Math.min(...allDates) - padMs;
const t1 = Math.max(...allDates) + padMs;
const x = (iso: string) => M.left + ((Date.parse(iso) - t0) / (t1 - t0)) * plotW;

/** Shorter form for axis labels. */
function fmtAxis(s: number): string {
  if (s < 60) return s.toFixed(0);
  const m = Math.floor(s / 60);
  return `${m}:${(s - m * 60).toFixed(0).padStart(2, "0")}`;
}

/** Gridline positions as a fraction of plot height, shared by both scales. */
const FRACTIONS = [0, 1 / 3, 2 / 3, 1];

const panels = ["50 Breast", "100 Breast"].map((event) => {
  const series = COURSES.map((course) => {
    const rows = swims.filter((s) => s.event === event && s.course === course.id);
    const secs = rows.map((s) => s.seconds);
    const spread = Math.max(...secs) - Math.min(...secs);
    // Padding proportional to the spread, so a tight series is not squashed
    // against the axis and a wide one does not float in whitespace.
    const margin = Math.max(spread * 0.08, 0.4);
    const lo = Math.min(...secs) - margin;
    const hi = Math.max(...secs) + margin;

    // lo maps to the TOP: smaller time = higher on the page.
    const y = (s: number) => M.top + ((s - lo) / (hi - lo)) * plotH;
    const pbs = rows.filter((s) => s.isPB);

    return {
      ...course,
      rows,
      pbs,
      y,
      lo,
      hi,
      // Value this scale carries at each shared gridline.
      ticks: FRACTIONS.map((f) => lo + (hi - lo) * f),
      // Stepped path: a record stands until it is beaten, so the line holds
      // flat then drops. A smooth curve between PBs would imply times he
      // never actually swam.
      path: pbs
        .map((p, i) =>
          i === 0 ? `M ${x(p.date)} ${y(p.seconds)}` : `H ${x(p.date)} V ${y(p.seconds)}`,
        )
        .join(" "),
      best: pbs[pbs.length - 1],
      first: rows[0],
      dropped: (rows[0].seconds - pbs[pbs.length - 1].seconds).toFixed(2),
    };
  });

  const scy = series[0];
  return {
    event,
    series,
    // The sub-minute barrier only exists in yards, so it is drawn on the short
    // course scale and labelled hard against the left axis to say so.
    milestone: event === "100 Breast" && scy.lo < 60 && scy.hi > 60 ? scy.y(60) : null,
    total: series.reduce((n, s) => n + s.rows.length, 0),
  };
});

const years = [2022, 2023, 2024, 2025, 2026];
const yGrid = FRACTIONS.map((f) => M.top + plotH * f);

// The chart is my own rendering of the data, so link the official record it
// came from. Someone who wants to check a time should be one click away.
const swimcloud = profile("swimcloud");
---

<section class="mt-16" aria-labelledby="swim-heading">
  <div
    class="border-rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b pb-2"
  >
    <h2 id="swim-heading" class="font-display text-3xl">Swimming</h2>
    <p class="data">
      <span>{swims.length} swims</span>
      <span class="text-rule mx-2">/</span>
      <a
        href={swimcloud.href}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-signal transition-colors"
      >
        SwimCloud
        <span class="ml-1" aria-hidden="true">&nearr;</span>
      </a>
    </p>
  </div>

  <p class="measure text-graphite mt-5">
    Breaststroke. Every race I have swum is on here, in both courses. The faint marks
    are all of them, and the solid line is the record, each best holding until it was
    beaten. Faster is up. The gap after May 2024 is shoulder surgery. Both short course
    bests came that December.
  </p>

  <p class="measure text-graphite mt-4">
    Yards and metres are not the same race, so each course is drawn against its own
    scale, short course on the left and long course on the right. Compare the shapes,
    not the heights.
  </p>

  <div class="mt-8 space-y-12">
    {
      panels.map((p) => (
        <figure>
          <figcaption>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <span class="font-display text-xl">{p.event}</span>
              <span class="data">{p.total} races</span>
            </div>

            {/* Doubles as the legend and as the numbers table, so the
                progression is readable by someone who never looks at the
                chart at all. */}
            <div class="mt-2 grid gap-x-10 gap-y-1 sm:grid-cols-2">
              {p.series.map((s) => (
                <span class="data flex flex-wrap items-baseline gap-x-2">
                  <span
                    class="inline-block size-2 shrink-0 rounded-full"
                    style={`background:${s.colour}`}
                    aria-hidden="true"
                  />
                  <span>{s.id}</span>
                  <span>{s.first.time}</span>
                  <span class="text-rule" aria-hidden="true">
                    &rarr;
                  </span>
                  <span style={`color:${s.colour}`}>{s.best.time}</span>
                  <span class="text-rule">/</span>
                  <span>&minus;{s.dropped}s</span>
                </span>
              ))}
            </div>
          </figcaption>

          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="mt-3 w-full overflow-visible"
            role="img"
            aria-label={p.series
              .map(
                (s) =>
                  `${s.label}: ${s.rows.length} races in the ${p.event}, from ${s.first.time} to a best of ${s.best.time}, an improvement of ${s.dropped} seconds.`,
              )
              .join(" ")}
          >
            {/* shared gridlines, labelled once per scale */}
            {yGrid.map((gy, i) => (
              <g>
                <line
                  x1={M.left}
                  x2={W - M.right}
                  y1={gy}
                  y2={gy}
                  stroke="var(--color-rule)"
                  stroke-width="1"
                />
                <text
                  x={M.left - 10}
                  y={gy + 3}
                  text-anchor="end"
                  class="font-mono text-[10px]"
                  fill="var(--color-signal)"
                  opacity="0.8"
                >
                  {fmtAxis(p.series[0].ticks[i])}
                </text>
                <text
                  x={W - M.right + 10}
                  y={gy + 3}
                  class="font-mono text-[10px]"
                  fill="var(--color-chart)"
                  opacity="0.8"
                >
                  {fmtAxis(p.series[1].ticks[i])}
                </text>
              </g>
            ))}

            {/* year ticks */}
            {years.map((yr) => (
              <text
                x={x(`${yr}-01-01`)}
                y={H - 10}
                text-anchor="middle"
                class="fill-graphite font-mono text-[10px]"
              >
                {yr}
              </text>
            ))}

            {/* sub-minute barrier, short course only */}
            {p.milestone && (
              <g>
                <line
                  x1={M.left}
                  x2={W - M.right}
                  y1={p.milestone}
                  y2={p.milestone}
                  stroke="var(--color-ink)"
                  stroke-width="1"
                  stroke-dasharray="2 3"
                />
                <text x={M.left + 6} y={p.milestone - 6} class="fill-ink font-mono text-[10px]">
                  1:00.00 SCY
                </text>
              </g>
            )}

            {/* career markers */}
            {markers.map((mk) => (
              <g>
                <line
                  x1={x(mk.date)}
                  x2={x(mk.date)}
                  y1={M.top}
                  y2={M.top + plotH}
                  stroke="var(--color-graphite)"
                  stroke-width="1"
                  stroke-dasharray="1 4"
                />
                <text
                  x={x(mk.date) + 6}
                  y={M.top + mk.dy}
                  class="fill-graphite font-mono text-[10px]"
                >
                  {mk.label}
                </text>
              </g>
            ))}

            {/* Long course drawn first, short course over the top: short
                course is the denser series and the one most people came for. */}
            {p.series
              .slice()
              .reverse()
              .map((s) => (
                <g>
                  {s.rows
                    .filter((r) => !r.isPB)
                    .map((r) => (
                      <circle
                        cx={x(r.date)}
                        cy={s.y(r.seconds)}
                        r="2.5"
                        fill="none"
                        stroke={s.colour}
                        stroke-width="1"
                        opacity="0.35"
                        data-swim={`${r.time} / ${s.id} / ${r.meet} / ${r.date}`}
                      />
                    ))}

                  <path
                    d={s.path}
                    fill="none"
                    stroke={s.colour}
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />

                  {s.pbs.map((r) => (
                    <circle
                      cx={x(r.date)}
                      cy={s.y(r.seconds)}
                      r="3.5"
                      fill={s.colour}
                      tabindex="0"
                      role="button"
                      aria-label={`${s.label} personal best ${r.time} at ${r.meet}, ${r.date}`}
                      data-swim={`${r.time} / ${s.id} / ${r.meet} / ${r.date}`}
                    />
                  ))}

                  <text
                    x={x(s.best.date) - 8}
                    y={s.y(s.best.seconds) - 9}
                    text-anchor="end"
                    class="font-mono text-[11px] font-medium"
                    fill={s.colour}
                  >
                    {s.best.time}
                  </text>
                </g>
              ))}
          </svg>

          <p class="data mt-2 min-h-[1.2em]" data-readout aria-live="polite">
            {p.series[0].best.time} / SCY / {p.series[0].best.meet}
          </p>
        </figure>
      ))
    }
  </div>
</section>

<script>
  // Progressive enhancement: the chart is fully readable without this.
  for (const fig of document.querySelectorAll<HTMLElement>("figure")) {
    const readout = fig.querySelector<HTMLElement>("[data-readout]");
    if (!readout) continue;

    const initial = readout.textContent;
    const show = (e: Event) => {
      const v = (e.target as HTMLElement).getAttribute("data-swim");
      if (v) readout.textContent = v;
    };
    const reset = () => {
      readout.textContent = initial;
    };

    for (const pt of fig.querySelectorAll<SVGElement>("[data-swim]")) {
      pt.addEventListener("mouseenter", show);
      pt.addEventListener("focus", show);
      pt.addEventListener("mouseleave", reset);
      pt.addEventListener("blur", reset);
    }
  }
</script>
