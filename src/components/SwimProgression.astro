---
// Swim progression plotted as ink on paper.
//
// 91 swims is far too many to list, and a table of times says nothing. So:
// every swim is a faint hollow mark (the volume, the grind), and the personal
// bests are drawn bold and connected - the record line cutting through the
// noise. Faster is UP, so improvement reads as ascent.
//
// Server-rendered SVG. No chart library, no client JS required to read it;
// the hover readout is progressive enhancement only.
import data from "../data/swims.json";
import { profile } from "../config/site";

interface Swim {
  event: string;
  time: string;
  seconds: number;
  meet: string;
  date: string;
  era: string;
  isPB: boolean;
}

const swims = data.swims as Swim[];

/**
 * Career markers. These are what turn the plot into a story rather than a
 * line: the surgery in particular is invisible in the personal-best line
 * (a record simply holds while you are out) and only shows up in the faint
 * marks - an eight-month gap in racing, then a return several seconds down.
 *
 * `dy` staggers the labels so they do not collide when markers fall close
 * together on the shared time axis.
 */
const markers = [
  { date: data.summary.moveDate as string, label: "moved to NH", dy: 10 },
  { date: "2024-05-01", label: "shoulder surgery", dy: 26 },
];

const W = 860;
const H = 250;
const M = { top: 18, right: 18, bottom: 30, left: 54 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;

// Shared time axis so the two panels line up and can be read against
// each other - the move marker sits at the same x in both.
const t0 = Date.parse("2021-04-01");
const t1 = Date.parse("2026-05-01");
const x = (iso: string) => M.left + ((Date.parse(iso) - t0) / (t1 - t0)) * plotW;

/** Shorter form for axis labels. */
function fmtAxis(s: number): string {
  if (s < 60) return s.toFixed(0);
  const m = Math.floor(s / 60);
  return `${m}:${(s - m * 60).toFixed(0).padStart(2, "0")}`;
}

const panels = ["50 Breast", "100 Breast"].map((event) => {
  const rows = swims.filter((s) => s.event === event);
  const secs = rows.map((s) => s.seconds);
  const lo = Math.min(...secs) - 0.6;
  const hi = Math.max(...secs) + 0.6;

  // lo maps to the TOP: smaller time = higher on the page.
  const y = (s: number) => M.top + ((s - lo) / (hi - lo)) * plotH;

  const ticks = Array.from({ length: 4 }, (_, i) => lo + ((hi - lo) * i) / 3);
  const pbs = rows.filter((s) => s.isPB);

  return {
    event,
    rows,
    pbs,
    y,
    ticks,
    // Stepped path: a record stands until it is beaten, so the line holds
    // flat then drops. A smooth curve between PBs would imply times he
    // never actually swam.
    path: pbs
      .map((p, i) => (i === 0 ? `M ${x(p.date)} ${y(p.seconds)}` : `H ${x(p.date)} V ${y(p.seconds)}`))
      .join(" "),
    best: pbs[pbs.length - 1],
    first: rows[0],
    dropped: (rows[0].seconds - pbs[pbs.length - 1].seconds).toFixed(2),
    // The 100 has a milestone worth drawing: breaking a minute.
    milestone: event === "100 Breast" && lo < 60 && hi > 60 ? 60 : null,
  };
});

const years = [2022, 2023, 2024, 2025, 2026];

// The chart is my own rendering of the data, so link the official record it
// came from. Someone who wants to check a time should be one click away.
const swimcloud = profile("swimcloud");
---

<section class="mt-16" aria-labelledby="swim-heading">
  <div class="border-rule flex items-baseline justify-between border-b pb-2">
    <h2 id="swim-heading" class="font-display text-3xl">Swimming</h2>
    <p class="data hidden sm:block">
      <span>{swims.length} swims / 2021-2026</span>
      <span class="text-rule mx-2">/</span>
      <a
        href={swimcloud.href}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-signal transition-colors"
      >
        SwimCloud
        <span class="ml-1" aria-hidden="true">&nearr;</span>
      </a>
    </p>
  </div>

  <p class="measure text-graphite mt-5">
    Breaststroke, short course yards. Every race I have swum is on here. The faint marks
    are all of them. The solid line is the record, each best holding until it was beaten.
    Faster is up. The gap after May 2024 is shoulder surgery. Both best times came that
    December.
  </p>

  <div class="mt-10 space-y-12">
    {
      panels.map((p) => (
        <figure>
          <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <span class="font-display text-xl">{p.event}</span>
            <span class="data">
              <span>{p.first.time}</span>
              <span class="text-rule mx-2">→</span>
              <span class="text-signal">{p.best.time}</span>
              <span class="text-rule mx-2">/</span>
              <span>−{p.dropped}s</span>
            </span>
          </figcaption>

          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="mt-3 w-full overflow-visible"
            role="img"
            aria-label={`${p.event}: ${p.rows.length} races from ${p.first.time} in 2021 to a best of ${p.best.time}, an improvement of ${p.dropped} seconds.`}
          >
            {/* horizontal gridlines + time labels */}
            {p.ticks.map((t) => (
              <g>
                <line
                  x1={M.left}
                  x2={W - M.right}
                  y1={p.y(t)}
                  y2={p.y(t)}
                  stroke="var(--color-rule)"
                  stroke-width="1"
                />
                <text
                  x={M.left - 10}
                  y={p.y(t) + 3}
                  text-anchor="end"
                  class="fill-graphite font-mono text-[10px]"
                >
                  {fmtAxis(t)}
                </text>
              </g>
            ))}

            {/* year ticks */}
            {years.map((yr) => (
              <text
                x={x(`${yr}-01-01`)}
                y={H - 10}
                text-anchor="middle"
                class="fill-graphite font-mono text-[10px]"
              >
                {yr}
              </text>
            ))}

            {/* sub-minute barrier */}
            {p.milestone && (
              <g>
                <line
                  x1={M.left}
                  x2={W - M.right}
                  y1={p.y(p.milestone)}
                  y2={p.y(p.milestone)}
                  stroke="var(--color-ink)"
                  stroke-width="1"
                  stroke-dasharray="2 3"
                />
                <text
                  x={W - M.right}
                  y={p.y(p.milestone) - 6}
                  text-anchor="end"
                  class="fill-ink font-mono text-[10px]"
                >
                  1:00.00
                </text>
              </g>
            )}

            {/* career markers */}
            {markers.map((mk) => (
              <g>
                <line
                  x1={x(mk.date)}
                  x2={x(mk.date)}
                  y1={M.top}
                  y2={M.top + plotH}
                  stroke="var(--color-graphite)"
                  stroke-width="1"
                  stroke-dasharray="1 4"
                />
                <text
                  x={x(mk.date) + 6}
                  y={M.top + mk.dy}
                  class="fill-graphite font-mono text-[10px]"
                >
                  {mk.label}
                </text>
              </g>
            ))}

            {/* every swim */}
            {p.rows
              .filter((s) => !s.isPB)
              .map((s) => (
                <circle
                  cx={x(s.date)}
                  cy={p.y(s.seconds)}
                  r="2.5"
                  fill="none"
                  stroke="var(--color-graphite)"
                  stroke-width="1"
                  opacity="0.45"
                  data-swim={`${s.time} · ${s.meet} · ${s.date}`}
                />
              ))}

            {/* the record line */}
            <path
              d={p.path}
              fill="none"
              stroke="var(--color-signal)"
              stroke-width="1.5"
              stroke-linejoin="round"
            />

            {/* personal bests */}
            {p.pbs.map((s) => (
              <circle
                cx={x(s.date)}
                cy={p.y(s.seconds)}
                r="3.5"
                fill="var(--color-signal)"
                tabindex="0"
                role="button"
                aria-label={`Personal best ${s.time} at ${s.meet}, ${s.date}`}
                data-swim={`${s.time} · ${s.meet} · ${s.date}`}
              />
            ))}

            {/* call out the current best */}
            <text
              x={x(p.best.date) - 8}
              y={p.y(p.best.seconds) - 9}
              text-anchor="end"
              class="fill-ink font-mono text-[11px] font-medium"
            >
              {p.best.time}
            </text>
          </svg>

          <p class="data mt-2 min-h-[1.2em]" data-readout aria-live="polite">
            {p.best.time} / {p.best.meet}
          </p>
        </figure>
      ))
    }
  </div>
</section>

<script>
  // Progressive enhancement: the chart is fully readable without this.
  for (const fig of document.querySelectorAll<HTMLElement>("figure")) {
    const readout = fig.querySelector<HTMLElement>("[data-readout]");
    if (!readout) continue;

    const initial = readout.textContent;
    const show = (e: Event) => {
      const v = (e.target as HTMLElement).getAttribute("data-swim");
      if (v) readout.textContent = v;
    };
    const reset = () => {
      readout.textContent = initial;
    };

    for (const pt of fig.querySelectorAll<SVGElement>("[data-swim]")) {
      pt.addEventListener("mouseenter", show);
      pt.addEventListener("focus", show);
      pt.addEventListener("mouseleave", reset);
      pt.addEventListener("blur", reset);
    }
  }
</script>
