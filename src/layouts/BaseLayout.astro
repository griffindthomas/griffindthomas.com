---
// Self-hosted fonts. Imported here rather than via @import in global.css so
// bundling handles them and no request ever leaves for a third-party CDN.
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import AltimeterTape from "../components/AltimeterTape.astro";
import MetarStrip from "../components/MetarStrip.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to the social preview image. */
  image?: string;
  /** Drop the default page padding, for pages that manage their own layout. */
  bare?: boolean;
  /** Keep the page out of search results and the sitemap. */
  noindex?: boolean;
}

const { title, description, image, bare = false, noindex = false } = Astro.props;

// Astro.site is set in astro.config.mjs, so these resolve to absolute URLs -
// required for OG tags, which reject relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
// The card that renders when the site is pasted into LinkedIn, a message or
// Slack. Pages may override it; everything else falls back to the griffin
// card. Regenerate with `node scripts/make-og.mjs`.
const ogImage = new URL(image ?? "/og.png", Astro.site);

/**
 * Cache buster on the icon URLs.
 *
 * Browsers keep favicons in their own store, keyed by URL, and revalidate
 * them when they feel like it rather than when the file changes. This site
 * shipped Astro's default icon first, and that copy kept coming back on
 * machines that had seen it. Bumping this changes the URL, which is the only
 * reliable way to retire the old one. Bump it whenever the artwork changes.
 */
const ICONS = "2";

const SITE_NAME = "Griffin Thomas";
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Griffin crest, cropped to the bird because the full logo with its
        swoosh is 1.8:1 and dissolves at 16px.

        The SVG is a real vector tracing and is listed first on purpose: it is
        the only one of these that adapts, going navy on a light browser and
        paper on a dark one. An earlier attempt did this by wrapping the PNG
        in an SVG `<image>`, which renders as an ordinary image but not as a
        tab icon, and left the tab blank. Geometry has no such problem.

        The PNGs are the fallback and stay navy. Regenerate everything with
        `node scripts/make-favicons.mjs`. */}
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${ICONS}`} />
    <link rel="icon" href={`/favicon.ico?v=${ICONS}`} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${ICONS}`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`/favicon-192.png?v=${ICONS}`} />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICONS}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}, ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="bg-paper text-ink flex min-h-svh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <MetarStrip />
    <SiteNav />

    <main id="main" class={bare ? "flex-1" : "flex-1 px-5 py-12 sm:px-8 lg:px-12"}>
      <slot />
    </main>

    <SiteFooter />

    <AltimeterTape />
  </body>
</html>
