---
// Self-hosted fonts. Imported here rather than via @import in global.css so
// bundling handles them and no request ever leaves for a third-party CDN.
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to the social preview image. */
  image?: string;
  /** Drop the default page padding, for pages that manage their own layout. */
  bare?: boolean;
  /** Keep the page out of search results and the sitemap. */
  noindex?: boolean;
}

const { title, description, image, bare = false, noindex = false } = Astro.props;

// Astro.site is set in astro.config.mjs, so these resolve to absolute URLs -
// required for OG tags, which reject relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
// The card that renders when the site is pasted into LinkedIn, a message or
// Slack. Pages may override it; everything else falls back to the griffin
// card. Regenerate with `node scripts/make-og.mjs`.
const ogImage = new URL(image ?? "/og.png", Astro.site);

const SITE_NAME = "Griffin Thomas";
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Griffin crest, cropped to the bird because the full logo with its
        swoosh is 1.8:1 and dissolves at 16px.

        The SVG is a real vector tracing and is listed first on purpose: it is
        the only one of these that adapts, going navy on a light browser and
        paper on a dark one. An earlier attempt did this by wrapping the PNG
        in an SVG `<image>`, which renders as an ordinary image but not as a
        tab icon, and left the tab blank. Geometry has no such problem.

        The PNGs are the fallback and stay navy. Regenerate everything with
        `node scripts/make-favicons.mjs`. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}, ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="bg-paper text-ink flex min-h-svh flex-col">
    <a
      href="#main"
      class="bg-ink text-paper sr-only px-4 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
    >
      Skip to content
    </a>

    <SiteNav />

    <main id="main" class={bare ? "flex-1" : "flex-1 px-5 py-12 sm:px-8 lg:px-12"}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
