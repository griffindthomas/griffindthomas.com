photos-inbox/

# Flight path showpiece: built and working, but Griffin does not want it on
# the site. Ignored rather than merely uncommitted so that a `git add -A`
# cannot sweep it into a push by accident. Remove this line only when he
# asks for it specifically.
src/components/FlightPath.astro

# Exploded UAV view: a test concept, not for the site. Same rule as the flight
# path above, and for the same reason: ignored rather than merely uncommitted
# so that `git add -A` cannot sweep it into a push. Remove this line only when
# Griffin asks for it specifically.
src/components/UavExploded.astro

# Natural Earth source geometry, cached by scripts/build-basemap.mjs. Large,
# public domain, and re-downloadable; the projected output in src/data is what
# ships and what is committed.
.cache/
